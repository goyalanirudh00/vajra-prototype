# Environment Variables Template
# 
# IMPORTANT: This is a TEMPLATE file. Do NOT commit your actual .env file to Git!
# 
# To use:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys
# 3. .env is already in .gitignore, so it won't be committed

# OpenAI API Key for Vajra Prototype
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenWeatherMap API Key for Real-Time Weather Data
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Google Places API Key for Store Address Autocomplete
# Get your API key from: https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
